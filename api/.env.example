# Monoton Agentic Commerce API Configuration

# Ledger connection
LEDGER_HOST=localhost
LEDGER_PORT=6865
LEDGER_TLS=false

# Authentication (OAuth2/JWT)
AUTH_ISSUER=https://auth.example.com
AUTH_AUDIENCE=monoton-api

# CORS
CORS_ORIGIN=*

# Server
PORT=3000
LOG_LEVEL=info
ENVIRONMENT=development

# Application
DAR_PATH=../main/.daml/dist/monotron-main-0.0.1.dar

# Optional: Override the operator party for invoice creation
# INVOICE_OPERATOR=Operator

# Optional: Instrument admin party for Canton Coin
# INSTRUMENT_ADMIN=CantonCoin
