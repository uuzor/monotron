-- Monoton: B2B Invoice Settlement with Privacy-Preserving Agentic Commerce
-- Built for Build on Canton Hackathon
--
-- Architecture from monotron-wallet-invoice-lifecycle.md:
-- - Uses Canton Token Standard (CIP-0056) for wallet/settlement
-- - Ride on Devnet Canton Coin (don't mint own instrument)
-- - Path A settlement (single atomic batch call)
-- - Privacy: Only stakeholders see contracts (signatory/observer model)

module Main where

-- =============================================================================
-- INVOICE STATUS
-- =============================================================================

-- | Invoice status throughout its lifecycle
data InvoiceStatus
  = Created                -- Invoice created by seller, awaiting buyer approval
  | Approved               -- Buyer approved the invoice
  | AwaitingSettlement     -- Settlement transfer initiated
  | Settled                -- Funds have been transferred
  | Rejected               -- Buyer rejected the invoice
  deriving (Eq, Show)

-- =============================================================================
-- TRANSFER INSTRUCTION (CIP-0056 Reference)
-- =============================================================================
-- This is a STUB for the Canton Token Standard (CIP-0056) TransferInstruction.
-- We don't implement this - it's provided by the Canton Token Standard DAR.
-- See: https://github.com/canton-foundation/cips/blob/main/cip-0056/
--
-- For deployment to Canton Devnet:
-- 1. Add data-dependencies on the Canton Token Standard DAR
-- 2. Change Invoice_InitiateSettlement to use ContractId TransferInstruction
--    (the real interface from Canton Token Standard)
--
-- For local testing, we use a placeholder template that mirrors the interface.

template TransferInstruction
  with
    sender : Party
    receiver : Party
    amount : Decimal
    transferId : Text
  where
    signatory sender
    observer receiver

    -- Accept the transfer (receiver signs off)
    choice TransferInstruction_Accept : ContractId TransferInstruction
      controller receiver
      do pure self

    -- Reject the transfer
    choice TransferInstruction_Reject : ContractId TransferInstruction
      with reason : Text
      controller receiver
      do pure self

    -- Withdraw/cancel the transfer
    choice TransferInstruction_Withdraw : ContractId TransferInstruction
      controller sender
      do pure self

-- =============================================================================
-- BUSINESS REGISTRATION (Onboarding)
-- =============================================================================
-- Represents a business onboarded to Monoton.
-- This is the ledger fact that proves a party is a valid Monoton counterparty.
-- Nothing should reference a business in an Invoice unless they have an active
-- BusinessRegistration. This is checked by the API layer.

data BusinessStatus
  = Active     -- Business is active and can create/receive invoices
  | Suspended  -- Business is suspended (can be reactivated)
  | Revoked    -- Business is revoked (permanent)
  deriving (Eq, Show)

template BusinessRegistration
  with
    business : Party       -- The business's Canton party
    operator : Party       -- Monoton operator who registered this business
    businessName : Text    -- Human-readable business name
    taxId : Text          -- Tax/company identifier
    status : BusinessStatus
    registeredAt : Time   -- When business was registered
  where
    signatory operator
    observer business

    ensure business /= operator
         && businessName /= ""
         && taxId /= ""

    -- Operator can suspend a business (e.g., for KYC review)
    choice Business_Suspend : ContractId BusinessRegistration
      with reason : Text
      controller operator
      do
        assert (status == Active)
        create this with status = Suspended

    -- Operator can reactivate a suspended business
    choice Business_Reactivate : ContractId BusinessRegistration
      controller operator
      do
        assert (status == Suspended)
        create this with status = Active

    -- Operator can permanently revoke a business
    choice Business_Revoke : ContractId BusinessRegistration
      with reason : Text
      controller operator
      do
        assert (status /= Revoked)
        create this with status = Revoked

-- =============================================================================
-- SETTLEMENT DELEGATION (Path A Authorization)
-- =============================================================================
-- For Path A settlement: the seller pre-authorizes the operator to accept
-- incoming transfers on their behalf. This makes the authorization a ledger
-- fact that the ledger enforces, not just a JWT claim Monoton's backend claims.
--
-- This is what makes "the operator can settle for me" structurally true:
-- - Without this: the operator's backend *claims* it can act for the seller
-- - With this: the ledger *enforces* that the operator can accept transfers
--   tagged with this seller's invoices

template SettlementDelegation
  with
    seller : Party      -- The delegating party (seller)
    operator : Party   -- The authorized operator
    scope : Text       -- Scope of delegation (e.g., "invoice-settlement", "all")
    validFrom : Time   -- When delegation becomes valid
    validUntil : Time  -- When delegation expires (for time-bound authorization)
    active : Bool     -- Whether delegation is currently active
  where
    signatory seller
    observer operator

    ensure seller /= operator
         && scope /= ""
         && validFrom <= validUntil

    -- Seller can revoke the delegation at any time
    choice Delegation_Revoke : ContractId SettlementDelegation
      with reason : Text
      controller seller
      do
        create this with active = False

    -- Seller can extend the validity period
    choice Delegation_Extend : ContractId SettlementDelegation
      with newValidUntil : Time
      controller seller
      do
        assert (active)
        assert (newValidUntil > validUntil)
        create this with validUntil = newValidUntil

    -- Operator can pause (but not revoke) the delegation
    choice Delegation_Pause : ContractId SettlementDelegation
      controller operator
      do
        assert (active)
        create this with active = False

    -- Operator can resume a paused delegation
    choice Delegation_Resume : ContractId SettlementDelegation
      controller operator
      do
        assert (not active)
        create this with active = True

-- =============================================================================
-- INVOICE (Core Settlement Contract)
-- =============================================================================
-- The Invoice template implements the B2B payment lifecycle:
-- 1. Seller creates invoice (Created)
-- 2. Buyer approves (Approved)
-- 3. Buyer initiates settlement (AwaitingSettlement) - creates TransferInstruction
-- 4. Operator confirms settlement (Settled)
--
-- Privacy: Only seller, buyer, operator are ever aware of this contract.
-- This is enforced structurally by Daml's signatory/observer model.

template Invoice
  with
    seller : Party       -- Business issuing the invoice (signatory)
    buyer : Party         -- Business that will pay (observer)
    operator : Party      -- Monoton operator (observer)
    amount : Decimal      -- Payment amount
    currency : Text      -- Currency code (e.g., "USD")
    description : Text    -- Invoice description
    dueDate : Date       -- Payment deadline
    status : InvoiceStatus
    invoiceId : Text     -- Unique invoice identifier
    -- Instrument admin party (from Canton Token Standard/Canton Coin registry)
    -- This is the party that administers the instrument being transferred
    instrumentAdmin : Party
  where
    signatory seller
    observer buyer, operator

    ensure amount > 0.0
         && seller /= buyer
         && seller /= operator
         && buyer /= operator

    -- Seller can update description while invoice is in Created status
    choice Invoice_UpdateDescription : ContractId Invoice
      with newDescription : Text
      controller seller
      do
        assert (status == Created)
        create this with description = newDescription

    -- Buyer approves the invoice
    choice Invoice_Approve : ContractId Invoice
      controller buyer
      do
        assert (status == Created)
        create this with status = Approved

    -- Buyer rejects the invoice
    choice Invoice_Reject : ContractId Invoice
      with rejectionReason : Text
      controller buyer
      do
        assert (status == Created)
        create this with status = Rejected

    -- Buyer initiates settlement (Path A)
    -- This is a NON-CONSUMING choice because:
    -- 1. The actual transfer happens via the Token Standard (separate ledger transaction)
    -- 2. The TransferInstruction CID is created off-ledger via registry API first
    -- 3. This choice marks the invoice as awaiting settlement
    --
    -- For Path A: the API layer submits BOTH:
    --   - TransferInstruction_Accept (operator acting for seller, via SettlementDelegation)
    --   - Invoice_ConfirmSettled (operator marking settlement complete)
    -- in a single Canton batch transaction
    nonconsuming choice Invoice_InitiateSettlement : ContractId Invoice
      with
        -- Reference to the TransferInstruction contract (created via registry API)
        -- This links the invoice to the actual token transfer
        transferInstructionCid : ContractId TransferInstruction
      controller buyer
      do
        assert (status == Approved)
        create this with status = AwaitingSettlement

    -- Operator confirms that settlement has completed
    -- This is called AFTER the TransferInstruction_Accept has been exercised
    -- The operator is asserting that the token transfer actually happened,
    -- not authorizing a new transfer
    choice Invoice_ConfirmSettled : ContractId Invoice
      with
        -- Final transfer ID from the registry (for audit trail)
        settledTransferId : Text
      controller operator
      do
        assert (status == AwaitingSettlement)
        create this with status = Settled

    -- Operator can cancel settlement if it times out
    -- (e.g., TransferInstruction expired without acceptance)
    choice Invoice_CancelSettlement : ContractId Invoice
      with cancellationReason : Text
      controller operator
      do
        assert (status == AwaitingSettlement)
        create this with status = Approved
